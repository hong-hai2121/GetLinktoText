# ── Meta Marketing API ────────────────────────────────────────────────────────
# Access token có quyền ads_read trên tài khoản quảng cáo.
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID tài khoản quảng cáo (có hoặc không có tiền tố act_ đều được).
META_AD_ACCOUNT_ID=act_123456789012345
# (Tùy chọn) phiên bản Graph API, mặc định v20.0
FB_API_VERSION=v20.0

# ── Google Sheets ─────────────────────────────────────────────────────────────
# ID của Google Sheet dùng làm database tạm (phần giữa /d/.../edit trên URL).
GOOGLE_SHEET_ID=1aBWyX1f3yjMVbbJ7HxDbvS3ZvjBL9JsXc3Ycm_gTwAc
# Đường dẫn tới file JSON service account (tương đối với thư mục dự án hoặc tuyệt đối).
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
