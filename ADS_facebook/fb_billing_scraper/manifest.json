{
  "manifest_version": 3,
  "name": "FB Billing Scraper",
  "version": "1.1.0",
  "description": "Cào dữ liệu billing từ Facebook Business và xuất Excel — giao diện mở thành cửa sổ riêng",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://business.facebook.com/*",
        "*://adsmanager.facebook.com/*",
        "*://www.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FB Billing Scraper — mở bảng điều khiển"
  }
}
