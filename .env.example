# Bản mẫu của .env — copy thành `.env` (cùng thư mục) rồi điền giá trị thật.
# File .env thật KHÔNG được commit (.gitignore đã che); file mẫu này thì commit
# để nhớ cấu trúc.

# ADS_facebook/fb_ads_accounts — token Marketing API (quyền ads_read)
FB_ADS_ACCOUNTS_TOKEN=EAAxxxxxxxxxxxxxxxxx

# ADS_facebook/fb_ads_tsAnhDuc — token Marketing API (quyền ads_read)
FB_ADS_TSANHDUC_TOKEN=EAAxxxxxxxxxxxxxxxxx

# facebook_ads_report — token Marketing API (quyền ads_read)
FB_ADS_REPORT_TOKEN=EAAxxxxxxxxxxxxxxxxx

# ── myedit — audio giọng nói → video ảnh minh họa ──────────────────────────
# Gemini API (chia cảnh + từ khóa ảnh) — lấy miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxx
# Kho ảnh stock (miễn phí, nên có ít nhất 1 key)
# https://www.pexels.com/api/ — 200 lượt/giờ
PEXELS_API_KEY=xxxxxxxxxxxxxxxxx
# https://pixabay.com/api/docs/ — 100 lượt/phút
PIXABAY_API_KEY=xxxxxxxxxxxxxxxxx
